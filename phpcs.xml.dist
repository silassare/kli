<?xml version="1.0"?>
<ruleset name="kli">
    <!-- Files or folders to sniff -->
    <file>src</file>
    <file>tests</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/ignore/*</exclude-pattern>
	<exclude-pattern>*/samples/*</exclude-pattern>

	<!-- Path to our coding standard folder -->
	<rule ref="vendor/oliup/oliup-cs-php/src"/>

	<!-- You should use at least PHP 8.5 -->
	<config name="testVersion" value="8.5-"/>
	<!-- Warnings (mostly line length) are reported but do not fail `make cs`. -->
	<config name="ignore_warnings_on_exit" value="1"/>
</ruleset>
