<?xml version="1.0"?>
<psalm
        xmlns:xi="http://www.w3.org/2001/XInclude"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        errorLevel="4"
        resolveFromConfigFile="true"
        phpVersion="8.5"
        xmlns="https://getpsalm.org/schema/config"
        xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="src"/>
        <!--
            The suite is analysed too: it is as much ours as `src/` is, and leaving it out hides the
            kind of fault only an analyser finds there, a call to a private constructor or a method
            that does not exist, which no test run reaches until the day it does.
        -->
        <directory name="tests"/>
        <ignoreFiles>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>

	<!-- The levels every Oliup package analyses at. Nothing here is repeated below. -->
	<xi:include href="vendor/oliup/oliup-cs-php/src/psalm/handlers.xml"/>
</psalm>
